{
  "name": "dorf-website",
  "version": "1.4.0",
  "private": true,
  "description": "Minimalistische Website für ein Skidorf – 360°-Panoramen, Galerie, Videos und Blog.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"../tests/unit/*.test.js\"",
    "test:e2e": "playwright test -c ../tests/playwright.config.js",
    "bilder": "node scripts/bilder.js",
    "postinstall": "node scripts/link-tests.js",
    "karte": "node scripts/karte-import.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "marked": "^18.1.3",
    "pannellum": "^2.5.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tmcw/togeojson": "^7.1.4",
    "@xmldom/xmldom": "^0.9.12",
    "sharp": "^0.35.5"
  }
}
